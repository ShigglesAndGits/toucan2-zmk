/*
 * Alex's Toucan 2 keymap - ported from the Sofle Hybrid Ergomech keymap
 * (ShigglesAndGits/sofle-hybrid-ergomech, config/sofle_ergomech.keymap).
 *
 * The Toucan is 3x6 + 3 thumbs per side with no number row and no encoder.
 * Thumb assignments follow the Sofle keystroke captures (Aug 2026, 61.6k presses):
 *   left  outer->inner: GUI (810), SPACE (8397), CTRL (639)  (Space centred to
 *   mirror Enter, per Alex)
 *   right inner->outer: RAISE/WORK (998), ENTER (583), LOWER (144)
 * CTRL is a plain thumb key because its top partners are Backspace (464),
 * V/A/C and Shift - a pinky mod-tap can't chord with A/Z/Shift.
 * GUI and RAISE stay on opposite hands for Super+RAISE+arrows (~1960 chords).
 * Alt, Del, Alt+Tab and sticky Ctrl+Alt were pressed 0 times, so they live
 * off the thumbs: Alt = hold Esc, Alt+Tab = RAISE+Tab, Del = RAISE+Backspace,
 * sticky Ctrl+Alt + Ctrl+Alt chords on WORK.
 *
 * LOWER = right-hand numpad (7-8-9 on U-I-O, 0 on the left centre thumb) with
 * brackets + BLE profiles on the left. SYSTEM (used twice) = RAISE + the left
 * centre (Space) thumb.
 *
 * Layer 4 MUST stay the mouse layer: toucan.dtsi's is_touching_processor
 * activates layer 4 while a finger is on the trackpad.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define WORK 3
#define MOUSE 4
#define SYSTEM 5

/ {
    behaviors {
        // RAISE keeps a tap dance so double-tap-hold reaches WORK (RDP chords).
        // 200ms term deliberate: 100ms made the WORK double-tap too tight.
        td_layer_work: tap_dance_layer_work {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo RAISE>, <&mo WORK>;
        };

        // Esc: tap = Esc, hold = Alt. Tap-preferred so fast Esc-then-key rolls
        // (vim) never turn into Alt chords; Alt needs a deliberate 200ms hold.
        ht_alt_esc: hold_alt_tap_esc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";

            // -------------------------------------------------------------------------------
            // | Esc/A |  Q  |  W  |  E   |  R   |  T   |   |  Y   |  U   |  I  |  O  |  P | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |   |  H   |  J   |  K  |  L  |  ; |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   |  N   |  M   |  ,  |  .  |  / |   -   |
            //                     | GUI  | SPACE| CTRL |   | RSE/WORK | ENTER | LOWER |
            // (Esc/A = tap Esc, hold Alt. Backspace and ' stay in their usual spots - moving
            //  Backspace to the pinky home key was tried and reverted. Right Shift was pressed
            //  once, so it's - / _.)

            bindings = <
&ht_alt_esc LALT ESC  &kp Q  &kp W  &kp E     &kp R      &kp T          &kp Y           &kp U      &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB               &kp A  &kp S  &kp D     &kp F      &kp G          &kp H           &kp J      &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHIFT            &kp Z  &kp X  &kp C     &kp V      &kp B          &kp N           &kp M      &kp COMMA  &kp DOT  &kp FSLH  &kp MINUS
                                    &kp LGUI  &kp SPACE  &kp LCTRL      &td_layer_work  &kp ENTER  &mo LOWER
            >;
        };

        lower {
            display-name = "LOWER";

            // -------------------------------------------------------------------------------
            // |       |  |  |  (  |  )   |  [   |  ]   |   |  -   |  7   |  8  |  9  |  /  | BKSPC |
            // |       |  \  |  {  |  }   |  <   |  >   |   |  +   |  4   |  5  |  6  |  *  |   '   |
            // |       | BT0 | BT1 | BT2  | BT3  | BT4  |   |  ,   |  1   |  2  |  3  |  .  |   =   |
            //                     |      |  0   |      |   |      |  ENT |  ▼  |
            // Numpad on the right hand (right thumb holds LOWER, Enter stays on the
            // centre thumb); 0 on the left centre thumb like a numpad's wide 0.
            // Left: brackets/pipes, BLE profile select on the bottom row (Sofle spot).

            bindings = <
&trans  &kp PIPE      &kp LPAR      &kp RPAR      &kp LBKT      &kp RBKT        &kp MINUS  &kp N7  &kp N8  &kp N9   &kp FSLH  &kp BACKSPACE
&trans  &kp BSLH      &kp LBRC      &kp RBRC      &kp LT        &kp GT          &kp PLUS   &kp N4  &kp N5  &kp N6   &kp STAR  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp COMMA  &kp N1  &kp N2  &kp N3   &kp DOT   &kp EQUAL
                                    &trans        &kp N0        &trans          &trans     &trans  &trans
            >;
        };

        raise {
            display-name = "RAISE";

            // -------------------------------------------------------------------------------
            // |       |  !  |  @  |  #   |  $   |  %   |   |  \   | HOME | PGDN | PGUP | END |  DEL  |
            // | A+TAB |  ^  |  &  |  *   |  -   |  _   |   |      |  <-  |  v   |  ^   |  -> |       |
            // |       |  `  |  ~  |  +   |      |      |   |      | S+<- | S+v  | S+^  | S+->|       |
            //                     |      |SYSTEM|      |   |  ▼   |      |      |
            // Left half = the Sofle number row's symbols. RAISE+Tab = Alt+Tab.
            // S+arrows = Super+arrow (Hyprland column focus, the top chord at 1340
            // presses) as a 2-key chord under the arrows. RAISE+Backspace = Del.
            // Holding the left centre (Space) thumb here reaches SYSTEM; it is not
            // on the inner thumb so Ctrl stays Ctrl even if RAISE goes down first.
            // Trackpad scrolls on this layer (see trackpad_listener override below).

            bindings = <
&trans        &kp EXCL   &kp AT     &kp HASH  &kp DLLR   &kp PRCNT     &kp BSLH  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END    &kp DEL
&kp LA(TAB)   &kp CARET  &kp AMPS   &kp STAR  &kp MINUS  &kp UNDER     &trans    &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &trans
&trans        &kp GRAVE  &kp TILDE  &kp PLUS  &trans     &trans        &trans    &kp LG(LEFT)  &kp LG(DOWN)  &kp LG(UP)  &kp LG(RIGHT)  &trans
                                    &trans    &mo SYSTEM &trans        &trans    &trans    &trans
            >;
        };

        work {
            display-name = "WORK";

            // Ctrl+Alt chords (KVM / remote-session control) + NumLock
            // -------------------------------------------------------------------------------
            // |  |  |  |  |     |  |   |         |         |        | NUMLK |  |  |
            // |  |  |  |  | sC+A|  |   |         | C-A-Brk | C-A-End| C-A-D |  |  |
            // |  |  |  |  |     |  |   |         |         |        |       |  |  |
            //          |  |     |  |   |         |         |        |
            // (sC+A = sticky Ctrl+Alt: tap, then tap any key to send Ctrl+Alt+key.)

            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans    &trans  &trans                   &trans           &trans           &kp KP_NUM  &trans
&trans  &trans  &trans  &trans  &sk LC(LALT)    &trans    &trans  &kp LC(LA(PAUSE_BREAK))  &kp LC(LA(END))  &kp LC(LA(DEL))  &trans      &trans
&trans  &trans  &trans  &trans  &trans          &trans    &trans  &trans                   &trans           &trans           &trans      &trans
                        &trans  &trans          &trans    &trans  &trans                   &trans
            >;
        };

        // Active while a finger is on the trackpad (toucan.dtsi -> &mo 4).
        // Mouse buttons sit where they were on the Sofle's LOWER layer, no
        // layer key needed: W/R = back/forward, S/D/F = right/middle/left click.
        // Thumbs stay transparent so GUI/Ctrl/RAISE keep working mid-touch.
        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans  &mkp MB4   &trans     &mkp MB5   &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &mkp RCLK  &mkp MCLK  &mkp LCLK  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans     &trans     &trans     &trans    &trans  &trans  &trans  &trans  &trans  &trans
                           &trans     &trans     &trans    &trans  &trans  &trans
            >;
        };

        system {
            display-name = "SYSTEM";

            // -------------------------------------------------------------------------------
            // |  F1   |  F2  |  F3  |  F4  |  F5  |  F6  |   |  F7    |  F8  |  F9  | F10  | F11 |  F12 |
            // |       | BT0  | BT1  | BT2  | BT3  | BT4  |   | BT_CLR | oBLE | oUSB | oTOG |     |      |
            // |       | MUTE | VOL- | VOL+ | PLAY |      |   |        | DEL  | END  | PAUSE| ESC |      |
            //                       |      |      |  ▼   |   |   ▼    |      |      |
            // (oBLE/oUSB/oTOG = output endpoint selection; the preference persists in flash.
            //  MUTE/VOL/PLAY replace the Sofle encoders and the old ALT double-tap.)

            bindings = <
&kp F1  &kp F2        &kp F3        &kp F4        &kp F5        &kp F6          &kp F7      &kp F8        &kp F9        &kp F10          &kp F11  &kp F12
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &out OUT_BLE  &out OUT_USB  &out OUT_TOG     &trans   &trans
&trans  &kp C_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PP      &trans          &trans      &kp DEL       &kp END       &kp PAUSE_BREAK  &kp ESC  &trans
                                    &trans        &trans        &trans          &trans      &trans        &trans
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};

// Scroll on RAISE only (Sofle behaviour). Stock Toucan also scrolls on layer 1,
// which would turn the pad into a scroller while the numpad (LOWER) is held.
&trackpad_listener {
    scroller {
        layers = <RAISE>;
    };
};

// 3-finger swipes (N, E, S, W) = Super+arrows, i.e. Hyprland column focus.
// Stock sent Ctrl+Super+arrows, which is moveintogroup (window tabbing) here.
&swipe_button_mapper {
    bindings = <&kp LG(UP)>, <&kp LG(RIGHT)>, <&kp LG(DOWN)>, <&kp LG(LEFT)>;
};

// Pinch = Ctrl+-/= (browser/app zoom). Stock Super+-/= is unbound in Hyprland.
&zip_zoom_mapper {
    bindings = <&kp LC(MINUS)>, <&kp LC(EQUAL)>;
};
